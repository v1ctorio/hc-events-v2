[{"id":"0d97afa8-47f1-495c-a4de-2ce404c682ad","slug":"canadian-trivia","title":"Canadian Trivia","desc":"Think you're a true Canadian? Do you love maple syrup? Can you correctly identify a toque on sight? It's time to prove it. We're hosting an Ultimate Canadian Trivia via Gimkit! Get ready for some absolute chaos in #community with everything from weird Canadian inventions to geography that makes no sense. Grab your snacks, channel your inner beaver, and get into the lobby. Keep your stick on the ice, eh?\n","leader":"J.​AI","cal":"https://www.google.com/calendar/render?action=TEMPLATE&text=Canadian%20Trivia&details=Think%20you%27re%20a%20true%20Canadian%3F%20Do%20you%20love%20maple%20syrup%3F%20Can%20you%20correctly%20identify%20a%20toque%20on%20sight%3F%20It%27s%20time%20to%20prove%20it.%20We%27re%20hosting%20an%20Ultimate%20Canadian%20Trivia%20via%20Gimkit%21%20Get%20ready%20for%20some%20absolute%20chaos%20in%20%23community%20with%20everything%20from%20weird%20Canadian%20inventions%20to%20geography%20that%20makes%20no%20sense.%20Grab%20your%20snacks%2C%20channel%20your%20inner%20beaver%2C%20and%20get%20into%20the%20lobby.%20Keep%20your%20stick%20on%20the%20ice%2C%20eh%3F%0A%5CnHack%20Club%20Event%20by%20J.%E2%80%8BAI&location=https%3A//app.slack.com/huddle/T0266FRGM/C01D7AHKMPF&dates=20260701T120000Z%2F20260701T140000Z","start":"2026-07-01T12:00:00Z","end":"2026-07-01T14:00:00Z","youtube":null,"ama":false,"amaForm":false,"amaId":"","amaAvatar":"","avatar":"https://cachet.dunkirk.sh/users/U097UCZE2BB/r","approved":true,"tags":["social"],"interestCount":4,"leaderSlackId":"U097UCZE2BB"},{"id":"32e31661-7278-44f8-a214-398a85e9315b","slug":"pull-request-hackaoke","title":"Pull Request: Hackaoke","desc":"Summer break, perfect time to take a break from coding... Here's a pull request for you: Hackaoke (Hack Club x Karaoke)! Merge to main (aka join us!) and commit your performance. This time, you need to push your vocals, not code. Review, approve, and deploy your inner talent (I know you've got it in you)... Hackaoke is your stage! Join us via huddle in #community!\n","leader":"J.​AI","cal":"https://www.google.com/calendar/render?action=TEMPLATE&text=Pull%20Request%3A%20Hackaoke&details=Summer%20break%2C%20perfect%20time%20to%20take%20a%20break%20from%20coding...%20Here%27s%20a%20pull%20request%20for%20you%3A%20Hackaoke%20%28Hack%20Club%20x%20Karaoke%29%21%20Merge%20to%20main%20%28aka%20join%20us%21%29%20and%20commit%20your%20performance.%20This%20time%2C%20you%20need%20to%20push%20your%20vocals%2C%20not%20code.%20Review%2C%20approve%2C%20and%20deploy%20your%20inner%20talent%20%28I%20know%20you%27ve%20got%20it%20in%20you%29...%20Hackaoke%20is%20your%20stage%21%20Join%20us%20via%20huddle%20in%20%23community%21%0A%5CnHack%20Club%20Event%20by%20J.%E2%80%8BAI&location=https%3A//app.slack.com/huddle/T0266FRGM/C01D7AHKMPF&dates=20260703T050000Z%2F20260703T070000Z","start":"2026-07-03T05:00:00Z","end":"2026-07-03T07:00:00Z","youtube":null,"ama":false,"amaForm":false,"amaId":"","amaAvatar":"","avatar":"https://cachet.dunkirk.sh/users/U097UCZE2BB/r","approved":true,"tags":["social"],"interestCount":3,"leaderSlackId":"U097UCZE2BB"},{"id":"fdd81400-b19e-4235-ab8e-596e614cba00","slug":"meccha-chameleon","title":"MECCHA CHAMELEON","desc":"Play Meccha Chameleon together. It's available on Steam for ~$10 or just _yk..._\nMax of 24 people (max server size), no mods.\n","leader":"BennyBoy635 Entity","cal":"https://www.google.com/calendar/render?action=TEMPLATE&text=MECCHA%20CHAMELEON&details=Play%20Meccha%20Chameleon%20together.%20It%27s%20available%20on%20Steam%20for%20~%2410%20or%20just%20_yk..._%0AMax%20of%2024%20people%20%28max%20server%20size%29%2C%20no%20mods.%0A%5CnHack%20Club%20Event%20by%20BennyBoy635%20Entity&location=https%3A//app.slack.com/huddle/T0266FRGM/C01D7AHKMPF&dates=20260704T103000Z%2F20260704T113000Z","start":"2026-07-04T10:30:00Z","end":"2026-07-04T11:30:00Z","youtube":null,"ama":false,"amaForm":false,"amaId":"","amaAvatar":